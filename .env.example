# Copy to a local file your shell sources (e.g. ~/.zshrc lines, or use direnv).
# Do NOT commit a populated .env to this repo.

# GitHub Personal Access Token used by the GitHub MCP server.
# Create at: https://github.com/settings/tokens
# Recommended scopes (read-only use):
#   - repo        (read private repos you're a member of)
#   - read:org    (see NER org membership)
# Fine-grained tokens scoped to the Northeastern-Electric-Racing org also work.
GITHUB_PERSONAL_ACCESS_TOKEN=
